# Local settings of rmprep-v2. agentcraft2 wrote the same text to .env, which is yours to change
# and is not committed. The tests read this file, not .env.
# A relative path is relative to this file.

# The model. 'fake' needs no account: it echoes the question, and tests script it.
AC2_MODEL_PROVIDER=fake

AC2_MODEL_ID=fake-model

# Applied only to Anthropic; switch MODEL_PROVIDER and MODEL_ID to use a real model.
AC2_MODEL_OPTIONS={"anthropic": {"prompt_caching": true, "cache_ttl": "5m"}}

# Optional model diagnostics: captures conversation content. Use test data.
# AC2_MODEL_TRACE_PATH=.agentcraft2/model-trace.jsonl

# Context limits for rmprep-v2: estimated tokens per model request, not per thread.
# The input limit includes tool definitions. Recent history shares the input limit
# with the selected memos, current question and tool results; it is not added to it.
RMPREP_CONTEXT_INPUT_TOKENS=128000
RMPREP_CONTEXT_RECENT_TOKENS=96000
RMPREP_CONTEXT_QUESTION_TOKENS=16000
RMPREP_CONTEXT_TOOL_SCHEMA_TOKENS=4000

# Limits for one Q&A question (planning estimates, not provider counts). Every value is
# optional; these are the defaults. A malformed or misspelled RMPREP_QNA_* name stops startup.
# RMPREP_QNA_INPUT_TOKENS=40000          the most one model request may hold, tool definitions included
# RMPREP_QNA_OUTPUT_TOKENS=4000          the most one model reply may use
# RMPREP_QNA_REQUEST_TOKENS=200000       input plus output reserved across every attempt of one question
# RMPREP_QNA_RECENT_TOKENS=8000          recent complete exchanges kept in a request
# RMPREP_QNA_QUESTION_TOKENS=2000
# RMPREP_QNA_DIRECTORY_TOKENS=2000
# RMPREP_QNA_WORKING_EVIDENCE_TOKENS=10000   tool results of the question kept whole in a request
# RMPREP_QNA_MAX_TOOL_CALLS=6
# RMPREP_QNA_MAX_MODEL_CALLS=8
# RMPREP_QNA_MAX_REVISIONS=2
# RMPREP_QNA_TIMEOUT_SECONDS=60
# RMPREP_QNA_MAX_NO_PROGRESS_REPEATS=2
# RMPREP_QNA_PREFETCH_CARDS=5            cards read before the model is asked; 0 turns this off

# The registries and the rules every service of the workspace shares.
AC2_REGISTRY_OPTIONS={"agents_path": "../../registry/agents.yaml", "tools_path": "../../registry/mcp-tools.yaml"}

AC2_POLICY_OPTIONS={"path": "../../policies/agentcraft2/rules/data.yaml"}

# Who a caller without a token is on this machine. Change the roles to see
# what the rules do. This development identity cannot be used when deployed.
AC2_IDENTITY_OPTIONS={"subject": "dev-user", "tenant": "dev-tenant", "roles": ["analyst"]}

# Optional Phoenix tracing on this machine: see docs/phoenix-trial.md in the repository.
# AC2_PHOENIX_ENABLED=true
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
# PHOENIX_PROJECT_NAME=rmprep-v2-trial
# AC2_PHOENIX_CAPTURE_CONTENT=false
